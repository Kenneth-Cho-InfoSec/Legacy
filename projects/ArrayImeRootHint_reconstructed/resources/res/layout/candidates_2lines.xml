<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:background="@drawable/candidate_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <HorizontalScrollView
            android:id="@+id/candview_scroll_2lines"
            android:background="@color/candidate_back_1line"
            android:scrollbars="none"
            android:fadingEdge="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/candidate_layout_height"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/candidates_view_2lines"
                android:background="@color/candidate_back_1line"
                android:layout_width="match_parent"
                android:layout_height="@dimen/candidate_layout_height"/>
        </HorizontalScrollView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/left_more_2lines"
            android:background="@drawable/cand_back_2line_left"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/candidate_layout_height">
            <ImageView
                android:id="@+id/left_more_imageview_2lines"
                android:background="@color/candidate_back_1line"
                android:clickable="true"
                android:layout_width="@dimen/candidate_layout_width"
                android:layout_height="match_parent"
                android:src="@drawable/cand_left"
                android:soundEffectsEnabled="false"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/cand_normal_text_size"
            android:textColor="@color/candidate_text"
            android:gravity="left"
            android:id="@+id/textViewRoot_2"
            android:background="@drawable/cand_back_2line_right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text=""/>
        <LinearLayout
            android:gravity="right"
            android:orientation="horizontal"
            android:id="@+id/candidates_view_2lines_2"
            android:background="@color/candidate_back_1line"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/candidate_layout_height"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/cand_normal_text_size"
                android:textColor="@color/candidate_text"
                android:gravity="center"
                android:id="@+id/textViewSymbolIME"
                android:background="@drawable/cand_back_2line_right"
                android:clickable="true"
                android:layout_width="@dimen/candidate_layout_width"
                android:layout_height="match_parent"
                android:text="  符  "/>
            <TextView
                android:textSize="@dimen/cand_normal_text_size"
                android:textColor="@color/candidate_text"
                android:gravity="center"
                android:id="@+id/textViewEngIME"
                android:background="@drawable/cand_back_2line_right"
                android:clickable="true"
                android:longClickable="true"
                android:layout_width="@dimen/candidate_layout_width"
                android:layout_height="match_parent"
                android:text="  英  "/>
            <TextView
                android:textSize="@dimen/cand_normal_text_size"
                android:textColor="@color/candidate_text"
                android:gravity="center"
                android:id="@+id/textViewHanziIME"
                android:background="@drawable/cand_back_2line_right"
                android:clickable="true"
                android:longClickable="true"
                android:layout_width="@dimen/candidate_layout_width"
                android:layout_height="match_parent"
                android:text="  中  "/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/right_more_2lines"
            android:background="@drawable/cand_back_2line_right"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/candidate_layout_height">
            <ImageView
                android:id="@+id/right_more_imageview_2lines"
                android:background="@color/candidate_back_1line"
                android:clickable="true"
                android:layout_width="@dimen/candidate_layout_width"
                android:layout_height="match_parent"
                android:src="@drawable/cand_right"
                android:soundEffectsEnabled="false"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:background="@drawable/candidate_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
