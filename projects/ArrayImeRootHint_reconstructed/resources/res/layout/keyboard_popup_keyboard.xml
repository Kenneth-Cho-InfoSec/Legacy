<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/keyboard_popup_panel_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.minn.android.hanziime.KeyboardView
        android:id="@+id/keyboardView"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:shadowColor="#bb000000"
        android:shadowRadius="0.5"
        android:layout_alignParentBottom="true"
        android:keyBackground="@drawable/btn_keyboard_key_std"
        android:keyTextSize="22dp"
        android:labelTextSize="14dp"
        android:keyTextColor="@color/key_text_color_std"
        android:keyPreviewLayout="@layout/keyboard_key_preview"
        android:keyPreviewOffset="-12dp"
        android:keyPreviewHeight="80dp"
        android:verticalCorrection="-10dp"
        android:popupLayout="@layout/keyboard_popup_keyboard"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/closeButton"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:src="@drawable/btn_close"/>
</LinearLayout>
