            android:keyLabel="；"/>
        <Key
            android:keyEdgeFlags="right"
            android:keyOutputText="："
            android:keyLabel="："/>
    </Row>
    <Row android:rowEdgeFlags="bottom">
        <Key
            android:keyWidth="10%p"
            android:codes="-114"
            android:keyEdgeFlags="left"
            android:keyIcon="@drawable/key_mode_hanzi_off"/>
        <Key
            android:keyWidth="10%p"
            android:codes="-104"
            android:keyIcon="@drawable/key_mode_half_alpha_off"/>
        <Key
            android:keyWidth="10%p"
            android:codes="-112"
            android:keyIcon="@drawable/key_mode_half_num_on"/>
        <Key
            android:keyWidth="40%p"
            android:codes="32"
            android:isRepeatable="true"
            android:keyIcon="@drawable/sym_keyboard_space"/>
        <Key
            android:codes="47"
            android:keyLabel="/"/>
        <Key
            android:keyWidth="10%p"
            android:codes="-101"
            android:keyIcon="@drawable/sym_keyboard_return"/>
        <Key
            android:keyWidth="10%p"
            android:codes="-100"
            android:keyEdgeFlags="right"
            android:isRepeatable="true"
            android:keyIcon="@drawable/sym_keyboard_delete"/>
    </Row>
</Keyboard>
