        <Key
            android:keyOutputText="╗"
            android:keyLabel="╗"/>
        <Key
            android:keyOutputText="═"
            android:keyLabel="═"/>
        <Key
            android:keyOutputText="【"
            android:keyLabel="【"/>
        <Key
            android:keyEdgeFlags="right"
            android:keyOutputText="】"
            android:keyLabel="】"/>
    </Row>
    <Row>
        <Key
            android:keyEdgeFlags="left"
            android:keyOutputText="├"
            android:keyLabel="├"/>
        <Key
            android:keyOutputText="┼"
            android:keyLabel="┼"/>
        <Key
            android:keyOutputText="┤"
            android:keyLabel="┤"/>
        <Key
            android:keyOutputText="│"
            android:keyLabel="│"/>
        <Key
            android:keyOutputText="╠"
            android:keyLabel="╠"/>
        <Key
            android:keyOutputText="╬"
            android:keyLabel="╬"/>
        <Key
            android:keyOutputText="╣"
            android:keyLabel="╣"/>
        <Key
            android:keyOutputText="║"
            android:keyLabel="║"/>
        <Key
            android:keyOutputText="§"
            android:keyLabel="§"/>
        <Key
            android:keyEdgeFlags="right"
            android:keyOutputText="‧"
            android:keyLabel="‧"/>
    </Row>
    <Row>
        <Key
            android:keyEdgeFlags="left"
            android:keyOutputText="└"
            android:keyLabel="└"/>
        <Key
            android:keyOutputText="┴"
            android:keyLabel="┴"/>
        <Key
            android:keyOutputText="┘"
            android:keyLabel="┘"/>
        <Key
            android:keyOutputText="，"
            android:keyLabel="，"/>
