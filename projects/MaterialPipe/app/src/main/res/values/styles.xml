    <!--
      MaterialPipe type scale.
      Named after M3 roles; sizes intentionally mirror the current UI so this is a
      parity-preserving step. Re-map sizes to the M3 type scale when the
      expressive material3 APIs land (M5). Apply with style="@style/TextAppearance.PipePipe.*".
    -->
    <style name="TextAppearance.PipePipe.Hero" parent="@android:style/TextAppearance">
        <item name="android:textSize">40sp</item>
    </style>
    <style name="TextAppearance.PipePipe.HeroSmall" parent="@android:style/TextAppearance">
        <item name="android:textSize">35sp</item>
    </style>
    <style name="TextAppearance.PipePipe.Headline" parent="@android:style/TextAppearance">
        <item name="android:textSize">24sp</item>
    </style>
    <style name="TextAppearance.PipePipe.TitleLarge" parent="@android:style/TextAppearance">
        <item name="android:textSize">22sp</item>
    </style>
    <style name="TextAppearance.PipePipe.Title" parent="@android:style/TextAppearance">
        <item name="android:textSize">20sp</item>
    </style>
    <style name="TextAppearance.PipePipe.TitleSmall" parent="@android:style/TextAppearance">
        <item name="android:textSize">18sp</item>
    </style>
    <style name="TextAppearance.PipePipe.BodyLarge" parent="@android:style/TextAppearance">
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.PipePipe.Body" parent="@android:style/TextAppearance">
        <item name="android:textSize">15sp</item>
    </style>
    <style name="TextAppearance.PipePipe.BodySmall" parent="@android:style/TextAppearance">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.PipePipe.Label" parent="@android:style/TextAppearance">
        <item name="android:textSize">13sp</item>
    </style>
    <style name="TextAppearance.PipePipe.LabelSmall" parent="@android:style/TextAppearance">
        <item name="android:textSize">12sp</item>
    </style>
    <style name="TextAppearance.PipePipe.Caption" parent="@android:style/TextAppearance">
        <item name="android:textSize">10sp</item>
    </style>

    <!--
      Inherited scale for the platform ?android:attr/textAppearance* usages.
      Inheriting from the platform appearances keeps resolution byte-identical
      (same size, weight and any inherited color/letter-spacing), so these are
      parity-preserving aliases that M5 will re-map to the M3E type scale.
    -->
    <style name="TextAppearance.PipePipe.Large" parent="@android:style/TextAppearance.Material.Large"/>
    <style name="TextAppearance.PipePipe.Medium" parent="@android:style/TextAppearance.Material.Medium"/>
    <style name="TextAppearance.PipePipe.Small" parent="@android:style/TextAppearance.Material.Small"/>

</resources>
