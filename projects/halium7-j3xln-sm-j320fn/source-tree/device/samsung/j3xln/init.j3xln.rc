# init.j3xln.rc - Device-specific init for SM-J320FN

on early-boot
    # Set up watchdog
    write /sys/class/misc/watchdog/watchdog "start"

on boot
    # Set up LCD
    write /sys/class/lcd/panel/lcd_power 1
    write /sys/class/backlight/panel/brightness 255

    # Set up touchscreen
    chmod 0660 /dev/input/event0
    chown system input /dev/input/event0

    # Set up audio
    write /sys/class/misc/accdet/mic_acc_detect 0
    write /sys/class/audio/earjack/earjack earpiece

    # GPS
    chmod 0660 /dev/ttyGPS0
    chown system system /dev/ttyGPS0

    # WiFi
    chmod 0660 /dev/wifi Walsh
    chown system system /dev/wifi Walsh
    chmod 0660 /dev/bt Walsh
    chown system system /dev/bt Walsh

    # Sensors
    chmod 0660 /dev/input/event1
    chown system input /dev/input/event1

on post-fs
    # Mount data with encryption support
    mount ext4 /dev/block/platform/sdio_emmc/by-name/userdata /data nosuid,nodev,noatime,noauto_da_alloc,errors=panic
    setprop vold.post_fs_data_done 1

on property:vold.decrypt=trigger_restart_framework
    start surfaceflinger
    start media
    start bootanim
    start default_service

on property:sys.storage.ums_enabled=1
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions mtp,adb,usb_mass_storage
    write /sys/class/android_usb/android0/enable 1

on property:sys.storage.ums_enabled=0
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/functions mtp,adb
    write /sys/class/android_usb/android0/enable 1

# Services
service surfaceflinger /system/bin/surfaceflinger
    class core
    user system
    group graphics drmrpc
    onrestart restart zygote

service media /system/bin/mediaserver
    class main
    user media
    group audio camera inet net_bt net_bt_admin net_raw radio graphics drmrpc
    onrestart restart surfaceflinger

service zygote /system/bin/app_process32 -Xzygote /system/bin --zygote --socket-name=zygote
    class main
    socket zygote stream 660 root system
    onrestart restart surfaceflinger
    onrestart restart media
    onrestart restart audio
    onrestart restart camera

service bootanim /system/bin/bootanimation
    class core
    user graphics
    group graphics
    disabled
    oneshot

service installd /system/bin/installd
    class main
    socket installd stream 600 system system

service flash_recovery /system/bin/flash_recovery.sh
    disabled
    oneshot

service sdcard /system/bin/sdcard -d /data/media 1023 1023
    class late_start

service.adb /system/bin/adbd --root_android_spawn --timeout=0
    class core
    socket adbd stream 660 system system
    disabled
    seclabel u:r:adbd:s0

# Property services
setprop persist.sys.root_access 1
setprop ro.adb.secure 0
setprop ro.secure 0
