# BoardConfig.mk for Samsung Galaxy J3 2016 (SM-J320FN)
# Spreadtrum SC9830A chipset
# Halium 7.1 compatible

# Platform & Architecture
TARGET_BOARD_PLATFORM := sc9830
TARGET_ARCH := arm
TARGET_ARCH_VARIANT := armv7-a-neon
TARGET_CPU_ABI := armeabi-v7a
TARGET_CPU_VARIANT := cortex-a7

# Boot & Kernel
BOARD_KERNEL_BASE := 0x80000000
BOARD_KERNEL_PAGESIZE := 2048
BOARD_FLASH_BLOCK_SIZE := 131072
BOARD_KERNEL_CMDLINE := androidboot.hardware=sc8830 user_debug=0 root=/dev/ram0 rw init=/init
BOARD_KERNEL_SEPARATED_DTB := true
TARGET_KERNEL_CONFIG := j3xln_defconfig
TARGET_KERNEL_SOURCE := kernel/samsung/j3xln
BOARD_KERNEL_PREBUILT_DTB := dtb.img
BOARD_DTB_SOURCE_DIR := $(TARGET_KERNEL_SOURCE)/arch/arm/boot/dts

# Boot Image
BOARD_MKBOOTIMG_ARGS := --kernel_offset 0x00008000 --ramdisk_offset 0x02000000 --tags_offset 0x01e00000 --board "SC9830"
BOARD_BOOTIMG_HEADER_VERSION := 1

# System Image
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true
BOARD_BOOTIMAGE_PARTITION_SIZE := 20971520
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 20971520
BOARD_SYSTEMIMAGE_PARTITION_SIZE := 2147483648
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_CACHEIMAGE_PARTITION_SIZE := 209715200
BOARD_USERDATAIMAGE_PARTITION_SIZE := 5104467968
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := ext4

# Recovery is not needed for Halium image builds
TARGET_NO_RECOVERY := true

# Hardware
BOARD_USES_GENERIC_AUDIO := true
BOARD_USES_ALSA_AUDIO := true
TARGET_SCREEN_DENSITY := 320
TARGET_SCREEN_HEIGHT := 1280
TARGET_SCREEN_WIDTH := 720
BOARD_CAMERA_LIBRARIES := libcamera
BOARD_HAVE_SAMSUNG_GPS := true
BOARD_WPA_SUPPLICANT_DRIVER := NL80211
BOARD_WPA_SUPPLICANT_PRIVATE_LIB := lib_driver_cmd_bcmdhd
BOARD_BLUETOOTH_BDROID_BUILDCFG_INCLUDE_DIR := device/samsung/j3xln/bluetooth
BOARD_HAVE_NFC := false

# Build Options
TARGET_ENABLE_CPUSETS := true
TARGET_USES_DEX2OAT := true
TARGET_USES_LOGD := true
BOARD_USES_METADATA_PARTITION := false

-include device/samsung/j3xln/BoardConfigPost.mk
